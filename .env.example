# Copiá este archivo a `.env` (en la raíz del repo) y ajustá lo que necesites.
# docker-compose.yml lee estas variables.

# Token compartido bot <-> API. Cambialo por cualquier string largo.
WORKER_TOKEN=dev-worker-token

# Zona horaria de los contenedores (afecta los timestamps de los logs).
TZ=America/Argentina/Buenos_Aires

# --- Solo para correr el backend SIN Docker (uvicorn/celery locales) ---------
# DATABASE_URL=sqlite:///./control.db
# REDIS_URL=redis://localhost:6379/0
# STORAGE_DIR=./storage
# ORCH_API_URL=http://localhost:8000
